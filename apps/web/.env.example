# Copie para apps/web/.env.local.
# Estes valores podem ser públicos no navegador; a segurança dos dados depende das policies RLS.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key
# Necessária apenas no servidor para enviar convites de professores por e-mail.
# Nunca use NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-hosted-service-role-key
# Preferida no backend Next.js; não é enviada ao navegador.
CORRECTION_API_URL=http://127.0.0.1:8000
# Compatibilidade temporária com ambientes existentes.
NEXT_PUBLIC_CORRECTION_API_URL=http://127.0.0.1:8000
CORRECTION_API_KEY=generate-a-secure-random-key
